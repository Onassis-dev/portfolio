---
interface Props {
  title: string;
  href: string;
  img?: string;
  text: string;
}

const { title, href, text } = Astro.props;
---

<div class="grid gap-4">
  <div class="flex flex-col h-full">
    <a
      href={href}
      class="font-medium tracking-tight text-title hover:underline"
    >
      {title}
    </a>
    <div class="flex flex-col gap-2">
      <span>{text}</span>
    </div>
  </div>
</div>
