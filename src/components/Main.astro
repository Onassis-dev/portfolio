---
import Layout from "../layouts/Layout.astro";
import Tech from "./Tech";
import H2 from "./H2";
import { t } from "../i18n/helper";
import Project from "./Project";
const { locale } = Astro.props;
---

<Layout title={t(locale, "headTitle")} locale={locale}>
  <section>
    <div class="space-y-4 mt-20 max-w-lg">
      <h1>
        {t(locale, "title")} Onassis
        <span class="greet">👋</span>
      </h1>

      <p>
        {t(locale, "description")}
      </p>
      <div class="flex gap-2 flex-wrap">
        <a
          class="flex gap-1.5 items-center border text-title h-8 px-2.5 rounded-lg"
          href="mailto:contact@onassis.dev"
          ><img alt="icono de correo" class="size-4" src="/mail.svg" />{
            t(locale, "contact")
          }</a
        >
        <a
          class="flex gap-1.5 items-center border text-title h-8 px-2.5 rounded-lg"
          href="https://www.linkedin.com/in/onassis-salinas-651b01313"
          ><img
            alt="logo de LinkedIn"
            class="size-4"
            src="/linkedin.svg"
          />LinkedIn</a
        >
        <a
          class="border text-title h-8 px-2.5 rounded-lg flex items-center"
          href={locale === "en" ? "/es" : "/"}
          >{locale === "en" ? "Español" : "English"}</a
        >
      </div>
    </div>
  </section>

  <section>
    <H2 text={t(locale, "projects")} client:load id="projects" />

    <div class="grid gap-8 pt-2">
      <Project
        title="Capupet"
        img="/screenshots/capupet.webp"
        href={`https://capupet.com/${locale}`}
        locale={locale}
        text={t(locale, "description_capupet")}
      />
      <Project
        title="Churchpaq"
        href={`https://churchpaq.com/${locale}`}
        img="/screenshots/churchpaq.webp"
        locale={locale}
        text={t(locale, "description_churchpaq")}
      />
      <Project
        title={t(locale, "title_internal_system")}
        img="/screenshots/erp.webp"
        locale={locale}
        text={t(locale, "description_internal_system")}
      />
      <!--
        - Geometry and bullets
        - meimei blog
        - Raytracing java game
        - 3d Render engine in JS
      /> -->
    </div>
  </section>

  <section>
    <H2 text={t(locale, "experience")} client:load id="experience" />

    <div class="flex gap-2 relative pb-4">
      <div class="h-full border-l mx-2 absolute left-0 top-0 bottom-0">
        <div
          class="size-5 rounded-full bg-border border-background border-4 absolute top-3.5 left-1/2 -translate-x-1/2"
        >
        </div>
      </div>

      <div class="flex-1 pl-7">
        <p class="font-semibold pt-3 text-title">{t(locale, "bcpetRole")}</p>
        <p>{t(locale, "bcpetDescription")}</p>
      </div>
    </div>
    <div class="flex gap-2 relative pb-4">
      <div class="h-full border-l mx-2 absolute left-0 top-0 bottom-0">
        <div
          class="size-5 rounded-full bg-border border-background border-4 absolute top-3.5 left-1/2 -translate-x-1/2"
        >
        </div>
      </div>

      <div class="flex-1 pl-7">
        <p class="font-semibold pt-3 text-title">
          {t(locale, "freelanceRole")}
        </p>
        <p>{t(locale, "freelanceDescription")}</p>
      </div>
    </div>
  </section>

  <section>
    <H2 text={t(locale, "nav_skills")} client:load id="skills" />

    <div class="flex flex-wrap gap-2">
      <Tech text="TypeScript" icon="typescript" />
      <Tech text="Tailwind" icon="tailwindcss" />
      <Tech text="React" icon="react_dark" />
      <Tech text="Svelte" icon="svelte" />
      <Tech text="Astro" icon="astro-icon-dark" />
      <Tech text="NextJS" icon="nextjs_icon_dark" />
      <Tech text="Hono" icon="hono" />
      <Tech text="Express" icon="expressjs_dark" />
      <Tech text="NestJS" icon="nestjs" />
      <Tech text="PostgreSQL" icon="postgresql" />
      <Tech text="Docker" icon="docker" />
      <Tech text="Git" icon="git" />
      <Tech text="UI/UX" icon="" />
    </div>
  </section>

  <section>
    <H2 text={t(locale, "collaborate")} client:load id="contact" />

    <div class="grid grid-cols-3 sm:grid-cols-6 gap-1">
      <div class="font-semibold text-title">{t(locale, "email")}</div>
      <a href="mailto:contact@onassis.dev" class="col-span-2 hover:underline"
        >contact@onassis.dev</a
      >
      <div class="font-semibold text-title">{t(locale, "linkedin")}</div>
      <a
        href="https://www.linkedin.com/in/onassis-salinas-651b01313"
        class="col-span-2 hover:underline">Onassis Salinas</a
      >
      <div class="font-semibold text-title">{t(locale, "github")}</div>
      <a
        href="https://github.com/Onassis-dev"
        class="col-span-2 hover:underline">Onassis-dev</a
      >
      <div class="font-semibold text-title">{t(locale, "location")}</div>
      <div class="col-span-2">{t(locale, "locationText")}</div>
    </div>
  </section>
</Layout>

<style is:global>
  @keyframes rotate {
    0% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(15deg);
    }
    75% {
      transform: rotate(-15deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  .greet {
    display: inline-block;
  }

  .greet:hover {
    animation: rotate 0.4s ease-out;
  }
</style>
