<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Character Counter</title>
    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: flex;
        align-items: center;
        min-height: 100vh;
        margin: 0;
        background-color: #1a1a1a;
        color: #e0e0e0;
        flex-direction: column;
      }

      .header {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        position: sticky;
        top: 0;
        background-color: #1a1a1a;
        padding: 16px;
        border-radius: 8px;
        margin-bottom: 10px;
      }

      h1 {
        font-size: 2rem;
        font-weight: 300;
        margin: 0 0 1rem 0;
      }

      input {
        width: min(90%, 600px);
        font-size: 16px;
        padding: 10px;
        background-color: #2b2b2b;
        border-radius: 8px;
        outline: none;
        scrollbar-color: #2b2b2b #1a1a1a;
      }

      #tasks {
        width: min(90%, 600px);
      }

      :global(.task) {
        border-radius: 8px;
        padding: 8px 12px;
        margin-bottom: 10px;
        background-color: #2b2b2b;
        color: #e0e0e0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
      }
      :global(.check-btn) {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        width: 16px;
        height: 16px;
        border-radius: 6px;
        background-color: #1a1a1a;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1>To-Do</h1>
      <input
        type="text"
        id="input"
        name="task"
        placeholder="Task"
        autocomplete="off"
      />
    </div>

    <div id="tasks"></div>
  </body>

  <script>
    const input = document.getElementById("input") as HTMLInputElement;
    const tasks = document.getElementById("tasks") as HTMLDivElement;
    const list = JSON.parse(localStorage.getItem("list") || "[]");

    renderList();

    input.addEventListener("keypress", (e) => {
      if (e.key === "Enter") {
        if (!input.value) return;
        list.push(input.value);
        renderList();
        input.value = "";
        localStorage.setItem("list", JSON.stringify(list));
      }
    });

    function renderList() {
      tasks.innerHTML = "";
      list.forEach((task) => renderTask(task));
    }

    function renderTask(task) {
      const card = document.createElement("div");
      card.classList.add("task");
      card.textContent = task;
      const button = document.createElement("input");
      button.type = "checkbox";
      button.classList.add("check-btn");
      button.addEventListener("click", () => {
        list.splice(list.indexOf(task), 1);
        renderList();
        localStorage.setItem("list", JSON.stringify(list));
      });
      card.appendChild(button);
      tasks.appendChild(card);
    }
  </script>
</html>
