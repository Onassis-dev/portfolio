<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Character Counter</title>
    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        background-color: #1a1a1a;
        color: #e0e0e0;
        flex-direction: column;
      }
      .container {
        text-align: center;
        padding: 2rem;
      }
      h1 {
        font-size: 2rem;
        font-weight: 300;
        margin: 0 0 1rem 0;
      }
      textarea {
        width: min(100%, 600px);
        height: 300px;
        font-size: 16px;
        padding: 10px;
        resize: none;
        background-color: #2b2b2b;
        border-radius: 8px;
        outline: none;
        scrollbar-color: #2b2b2b #1a1a1a;
      }
      .counter {
        margin-top: 10px;
        font-size: 18px;
      }
    </style>
  </head>
  <body>
    <h1>Character Counter</h1>
    <div
      style="display: flex; flex-direction: column; align-items: center; width: 100%"
    >
      <textarea id="text"></textarea>
      <div class="counter">Characters: <span id="count">0</span></div>
    </div>

    <script>
      const textarea = document.getElementById("text");
      const countDisplay = document.getElementById("count");

      textarea.addEventListener("input", () => {
        countDisplay.textContent = textarea.value.length;
      });
      textarea.focus();
    </script>
  </body>
</html>
