---
interface Props {
  frontmatter: {
    title: string;
    date: string;
  };
}

const { frontmatter } = Astro.props as Props;

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{frontmatter.title}</title>
  </head>
  <body class="relative min-h-screen flex flex-col">
    <Header locale="en" />
    <main class="blog max-w-[40rem] w-full mx-auto z-10 px-4 flex-1 mt-20">
      <h1>{frontmatter.title}</h1>
      <p class="!text-sm !mt-0 !mb-10">
        Published:
        {
          new Date(frontmatter.date).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </p>

      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .blog h2 {
    @apply text-2xl font-semibold mt-10 -mb-2 text-title;
  }
  .blog h3 {
    @apply text-xl font-semibold text-title;
  }
  .blog p {
    @apply text-base my-5;
  }
  .blog a {
    @apply underline text-title;
  }
  .blog ul {
    @apply list-disc list-inside;
  }
  .blog ol {
    @apply list-decimal list-inside;
  }
  .blog strong {
    @apply font-semibold text-title;
  }
  .blog code {
    @apply bg-neutral-800 text-foreground text-sm px-1 py-0.5 rounded-md;
  }
</style>
