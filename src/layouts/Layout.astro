---
interface Props {
  title: string;
  locale: string;
  blog?: boolean;
}

const { title, locale, blog = false } = Astro.props;

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";
import { t } from "../i18n/helper";

const baseUrl = "https://onassis.dev";
const canonicalPath = locale === "en" ? "/" : `/${locale}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={t(locale, "meta_description")} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    {
      !blog && (
        <>
          <link rel="preload" href="/screenshots/capupet.webp" as="image" />
          <link rel="preload" href="/screenshots/churchpaq.webp" as="image" />
          <link rel="preload" href="/screenshots/erp.webp" as="image" />
          <link rel="canonical" href={`${baseUrl}${canonicalPath}`} />
          <link rel="alternate" hreflang="en" href={`${baseUrl}/`} />
          <link rel="alternate" hreflang="es" href={`${baseUrl}/es`} />
          <link rel="alternate" hreflang="x-default" href={`${baseUrl}/`} />
        </>
      )
    }
  </head>
  <body class="relative min-h-screen flex flex-col">
    <Header locale={locale} />
    <main class="max-w-[40rem] mx-auto z-10 space-y-20 px-4 flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
